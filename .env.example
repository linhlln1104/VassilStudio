# VassilStudio local environment
#
# Copy to .env for local shells or pass these values into Docker Compose.
# Keep secrets out of commits and issue reports.

# Runtime roots
VASSIL_ROOT=C:\path\to\VassilStudio
VASSIL_CONFIG=config\vassil.example.json

# API automation keys, comma-separated. Browser login does not require this.
VASSIL_API_KEYS=

# Local Studio account/session auth. Set true for production-like local use.
VASSIL_AUTH_REQUIRED=false
VASSIL_AUTH_DB_PATH=data\auth.sqlite3
VASSIL_SESSION_SECRET=replace-with-random-32-plus-character-secret
VASSIL_SECURE_COOKIES=false

# Runtime behavior
VASSIL_ENV=local
# Keep loopback for normal local use. A LAN address requires auth or an API key.
VASSIL_BIND_ADDRESS=127.0.0.1
VASSIL_LOG_LEVEL=INFO
VASSIL_ASR_NUM_THREADS=2
VASSIL_TTS_NUM_THREADS=8
VASSIL_WARMUP_ON_STARTUP=false
VASSIL_TELEMETRY_ENABLED=false
