{
  "paths": {
    "models_root": "models",
    "data_root": "data",
    "logs_root": "logs"
  },
  "runtime": {
    "environment": "local",
    "bind_address": "127.0.0.1",
    "log_level": "INFO",
    "provider": "cpu",
    "num_threads": 2,
    "asr_num_threads": 2,
    "tts_num_threads": 8,
    "debug": false,
    "warmup_on_startup": false
  },
  "asr": {
    "enabled": true,
    "default_language": "vi",
    "sample_rate": 16000,
    "feature_dim": 80,
    "decoding_method": "greedy_search",
    "models": {
      "vi": {
        "encoder": "models/runtime/asr/vi/zipformer/encoder.onnx",
        "decoder": "models/runtime/asr/vi/zipformer/decoder.onnx",
        "joiner": "models/runtime/asr/vi/zipformer/joiner.onnx",
        "tokens": "models/runtime/asr/vi/zipformer/tokens.txt"
      },
      "en": {
        "encoder": "models/runtime/asr/en/zipformer/encoder.onnx",
        "decoder": "models/runtime/asr/en/zipformer/decoder.onnx",
        "joiner": "models/runtime/asr/en/zipformer/joiner.onnx",
        "tokens": "models/runtime/asr/en/zipformer/tokens.txt"
      }
    }
  },
  "tts": {
    "enabled": true,
    "default_language": "vi",
    "default_models": {
      "vi": "zipvoice-vi",
      "en": "zipvoice-en"
    },
    "profiles": {
      "zipvoice-vi": {
        "engine": "zipvoice",
        "label": "Vietnamese ZipVoice",
        "languages": [
          "vi"
        ],
        "sample_rate": 24000,
        "options": {
          "tokens": "models/runtime/tts/vi/zipvoice/tokens.txt",
          "encoder": "models/runtime/tts/vi/zipvoice/text_model.onnx",
          "decoder": "models/runtime/tts/vi/zipvoice/flow_matching_model.onnx",
          "vocoder": "models/runtime/tts/vi/zipvoice/vocos_24khz.onnx",
          "data_dir": "models/runtime/tts/vi/zipvoice/espeak-ng-data",
          "lexicon": "models/runtime/tts/vi/zipvoice/lexicon_vi_minimal.txt",
          "default_num_steps": 8,
          "default_speed": 1.0,
          "min_char_in_sentence": 30
        }
      },
      "zipvoice-en": {
        "engine": "zipvoice",
        "label": "English ZipVoice",
        "languages": [
          "en"
        ],
        "sample_rate": 24000,
        "options": {
          "tokens": "models/runtime/tts/en/zipvoice/tokens.txt",
          "encoder": "models/runtime/tts/en/zipvoice/text_model.onnx",
          "decoder": "models/runtime/tts/en/zipvoice/flow_matching_model.onnx",
          "vocoder": "models/runtime/tts/en/zipvoice/vocos_24khz.onnx",
          "data_dir": "models/runtime/tts/en/zipvoice/espeak-ng-data",
          "default_num_steps": 8,
          "default_speed": 1.0,
          "min_char_in_sentence": 30
        }
      },
      "vieneu-v3-turbo": {
        "engine": "vieneu",
        "label": "VieNeu TTS v3 Turbo",
        "languages": [
          "vi",
          "en"
        ],
        "sample_rate": 48000,
        "options": {
          "environment_dir": ".venv-vieneu",
          "model_dir": "models/runtime/tts/vieneu-v3-turbo/model",
          "onnx_dir": "models/runtime/tts/vieneu-v3-turbo/model/onnx_update",
          "cache_dir": "models/runtime/tts/vieneu-v3-turbo/hf-cache",
          "threads": 0,
          "denoise": true,
          "load_timeout_seconds": 180,
          "inference_timeout_seconds": 600
        }
      }
    }
  },
  "realtime": {
    "enabled": true,
    "encoding": "pcm_f32le",
    "chunk_seconds": 3.0,
    "min_chunk_seconds": 0.6,
    "max_buffer_seconds": 12.0,
    "silence_rms": 0.003
  },
  "jobs": {
    "asr_max_pending_jobs": 32,
    "tts_max_pending_jobs": 32,
    "asr_max_workers": 1,
    "tts_max_workers": 1,
    "asr_max_attempts": 1,
    "tts_max_attempts": 1,
    "retry_backoff_seconds": 0.5
  },
  "limits": {
    "max_upload_bytes": 52428800,
    "max_tts_text_chars": 5000,
    "max_reference_text_chars": 2000,
    "max_voice_name_chars": 120,
    "max_realtime_frame_bytes": 2097152
  },
  "storage": {
    "data_dir": "data",
    "voices_dir": "data/voices",
    "asr_jobs_dir": "data/jobs/asr",
    "tts_jobs_dir": "data/jobs/tts",
    "uploads_dir": "data/uploads",
    "outputs_dir": "data/outputs",
    "logs_dir": "logs"
  },
  "security": {
    "api_keys": [],
    "auth_required": false,
    "auth_db_path": "data/auth.sqlite3",
    "session_cookie_name": "vassil_session",
    "session_ttl_seconds": 604800,
    "session_secret": "",
    "secure_cookies": false
  }
}
